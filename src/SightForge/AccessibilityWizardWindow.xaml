<Window x:Class="SightForge.AccessibilityWizardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SightForge Accessibility Setup" Width="900" Height="680" Background="#10141C" Foreground="White">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock FontSize="30" FontWeight="Bold" Text="Accessibility Setup and Training"/><TextBlock Margin="0,8,0,16" FontSize="16" Foreground="#C2CBD8" Text="Build a comfortable starting profile for vision, color, hearing, speech, and controls."/></StackPanel>
<ScrollViewer Grid.Row="1"><StackPanel>
<TextBlock FontSize="20" FontWeight="SemiBold" Text="Vision"/><TextBlock Margin="0,8,0,0" Text="Starting magnification"/><Slider x:Name="MagnificationSlider" Minimum="1" Maximum="4" Value="1.5" TickFrequency="0.25" IsSnapToTickEnabled="True"/><CheckBox x:Name="EdgesCheck" Margin="0,10" FontSize="17" Content="Emphasize strong edges" IsChecked="True"/><CheckBox x:Name="MotionCheck" Margin="0,6" FontSize="17" Content="Emphasize visible motion"/>
<Separator Margin="0,18"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="Color and contrast"/><ComboBox x:Name="ThemeCombo" Margin="0,8" FontSize="17" SelectedIndex="1"><ComboBoxItem Content="Standard"/><ComboBoxItem Content="High Contrast Color-Blind Safe"/></ComboBox>
<Separator Margin="0,18"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="Speech"/><CheckBox x:Name="SpeechCheck" Margin="0,8" FontSize="17" Content="Enable spoken interface" IsChecked="True"/><TextBlock Text="Speech rate"/><Slider x:Name="SpeechRateSlider" Minimum="-5" Maximum="5" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"/><Button Margin="0,10,0,0" Padding="14,9" HorizontalAlignment="Left" Click="TestSpeech_Click" Content="Test Speech"/>
<Separator Margin="0,18"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="Directional assistance"/><CheckBox x:Name="ClockCheck" Margin="0,8" FontSize="17" Content="Speak clock directions for strong audio cues"/><CheckBox x:Name="HighConfidenceCheck" Margin="0,6" FontSize="17" Content="Only announce high-confidence directions" IsChecked="True"/>
<Separator Margin="0,18"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="Control preference"/><ComboBox x:Name="ControlCombo" Margin="0,8" FontSize="17" SelectedIndex="0"><ComboBoxItem Content="Keyboard and mouse"/><ComboBoxItem Content="Controller first"/><ComboBoxItem Content="Voice first"/></ComboBox>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,18,0" Foreground="#C2CBD8"/><Button Padding="18,10" Click="SaveButton_Click" Content="Save Starting Profile"/></StackPanel>
</Grid></Window>