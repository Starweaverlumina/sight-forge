<Window x:Class="SightForge.OcrReaderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SightForge Screen Reader" Width="900" Height="650" Background="#10141C" Foreground="White" KeyDown="Window_KeyDown">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock FontSize="30" FontWeight="Bold" Text="Read the Screen"/><TextBlock Margin="0,8,0,14" FontSize="16" Foreground="#C2CBD8" Text="Capture the primary display, recognize visible text locally, enlarge it, and read it aloud. Press F5 to scan."/><StackPanel Orientation="Horizontal"><Button Padding="16,10" Click="ScanButton_Click" Content="Scan Screen (F5)"/><Button Margin="10,0,0,0" Padding="16,10" Click="SpeakButton_Click" Content="Read Aloud"/><Button Margin="10,0,0,0" Padding="16,10" Click="StopButton_Click" Content="Stop Speech"/></StackPanel></StackPanel>
<TextBox x:Name="ResultText" Grid.Row="1" Margin="0,18" FontSize="26" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#05070A" Foreground="White" Padding="18" IsReadOnly="True" AutomationProperties.Name="Recognized screen text"/>
<TextBlock x:Name="StatusText" Grid.Row="2" FontSize="15" Foreground="#C2CBD8" Text="Ready."/>
</Grid></Window>