<Window x:Class="SightForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SightForge"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        Background="#111318"
        Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="30" FontWeight="Bold" Text="SightForge" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#B7BDC8"
                       Text="Universal low-vision gaming accessibility toolkit" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="14" Background="#1A1E26" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Preview" />
                    <Border Grid.Row="1" Margin="0,14,0,0" Background="Black" CornerRadius="10">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#8F98A8"
                                       Text="Screen capture preview will appear here" />
                            <Border Width="42" Height="42" BorderBrush="#FFD24A" BorderThickness="2" CornerRadius="21" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="14" Background="#1A1E26" Padding="18">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Visibility Controls" />

                    <TextBlock x:Name="MagnificationLabel" Margin="0,18,0,4" Text="Magnification" />
                    <Slider x:Name="MagnificationSlider"
                            Minimum="1" Maximum="4" Value="1.5" TickFrequency="0.25"
                            AutomationProperties.Name="Magnification"
                            AutomationProperties.LabeledBy="{Binding ElementName=MagnificationLabel}"
                            ValueChanged="MagnificationSlider_ValueChanged" />

                    <TextBlock x:Name="ContrastLabel" Margin="0,16,0,4" Text="Contrast" />
                    <Slider x:Name="ContrastSlider"
                            Minimum="0.5" Maximum="2.5" Value="1" TickFrequency="0.1"
                            AutomationProperties.Name="Contrast"
                            AutomationProperties.LabeledBy="{Binding ElementName=ContrastLabel}"
                            ValueChanged="ContrastSlider_ValueChanged" />

                    <TextBlock x:Name="GammaLabel" Margin="0,16,0,4" Text="Gamma" />
                    <Slider x:Name="GammaSlider"
                            Minimum="0.4" Maximum="2.2" Value="1" TickFrequency="0.1"
                            AutomationProperties.Name="Gamma"
                            AutomationProperties.LabeledBy="{Binding ElementName=GammaLabel}"
                            ValueChanged="GammaSlider_ValueChanged" />

                    <CheckBox x:Name="EdgeEnhancementCheckBox"
                              Margin="0,18,0,0"
                              Content="Edge enhancement"
                              Checked="EdgeEnhancementCheckBox_Toggled"
                              Unchecked="EdgeEnhancementCheckBox_Toggled" />
                    <CheckBox x:Name="MotionEmphasisCheckBox"
                              Margin="0,10,0,0"
                              Content="General motion emphasis"
                              Checked="MotionEmphasisCheckBox_Toggled"
                              Unchecked="MotionEmphasisCheckBox_Toggled" />
                    <CheckBox x:Name="CrosshairCheckBox"
                              Margin="0,10,0,0"
                              IsChecked="True"
                              Content="High-visibility center guide"
                              Checked="CrosshairCheckBox_Toggled"
                              Unchecked="CrosshairCheckBox_Toggled" />

                    <Button x:Name="StartButton"
                            Margin="0,24,0,0"
                            Height="44"
                            FontWeight="SemiBold"
                            Content="Start Compatibility Preview"
                            Click="StartButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Foreground="#B7BDC8"
                   Text="Status: Ready. No game-memory access or input automation." />
    </Grid>
</Window>
