<Window x:Class="SightForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SightForge — Low-Vision Gaming Toolkit"
        Width="1220" Height="860" MinWidth="920" MinHeight="700"
        Background="#101218" Foreground="White" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="0,5,0,0" /></Style>
        <Style TargetType="CheckBox"><Setter Property="FontSize" Value="15" /></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="32" FontWeight="Bold" Text="SightForge" />
                <TextBlock Margin="0,5,0,0" FontSize="15" Foreground="#BBC2D0"
                           Text="Independent live-feed, replay, adaptive vision, and directional audio accessibility" />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" Padding="12,7" CornerRadius="16" Background="#243127">
                <TextBlock Foreground="#A7F3B1" FontWeight="SemiBold" Text="Standalone Screen Layer" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="14" Background="#191D26" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Live Feed / Playback" />
                            <TextBlock x:Name="ReplayStatusText" Margin="0,4,0,0" FontSize="12" Foreground="#98A1B1" Text="Replay: empty" />
                            <TextBlock x:Name="AudioCueStatusText" Margin="0,3,0,0" FontSize="12" Foreground="#98A1B1" Text="Audio grid: off" />
                        </StackPanel>
                        <TextBlock x:Name="PerformanceText" Grid.Column="1" Foreground="#BBC2D0" Text="0 FPS" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,14" Background="Black" BorderBrush="#313846" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="LowQuality" />
                            <TextBlock x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"
                                       FontSize="17" Foreground="#98A1B1" TextAlignment="Center"
                                       Text="Start the independent live feed. SightForge can retain local replay, adapt visual filters, and produce directional tones from general motion regions." />
                            <Grid x:Name="CenterGuide" Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Ellipse Stroke="#FFFF4D" StrokeThickness="3" />
                                <Line X1="38" X2="38" Y1="0" Y2="24" Stroke="#FFFF4D" StrokeThickness="3" />
                                <Line X1="38" X2="38" Y1="52" Y2="76" Stroke="#FFFF4D" StrokeThickness="3" />
                                <Line X1="0" X2="24" Y1="38" Y2="38" Stroke="#FFFF4D" StrokeThickness="3" />
                                <Line X1="52" X2="76" Y1="38" Y2="38" Stroke="#FFFF4D" StrokeThickness="3" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Foreground="#98A1B1" FontSize="13"
                               Text="Directional tones represent the strongest general pixel-motion region in a 3×3 grid. They do not identify what moved or whether it is a player." />
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="14" Background="#191D26" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="Visibility Controls" />

                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Center magnification" /><TextBlock x:Name="MagnificationValue" Grid.Column="1" Foreground="#FFD85A" Text="1.00×" />
                        </Grid>
                        <Slider x:Name="MagnificationSlider" Minimum="1" Maximum="4" Value="1" TickFrequency="0.1" ValueChanged="SettingsControl_Changed" />

                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Contrast" /><TextBlock x:Name="ContrastValue" Grid.Column="1" Foreground="#FFD85A" Text="1.00" />
                        </Grid>
                        <Slider x:Name="ContrastSlider" Minimum="0.5" Maximum="2.5" Value="1" TickFrequency="0.05" ValueChanged="SettingsControl_Changed" />

                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Gamma / shadow lift" /><TextBlock x:Name="GammaValue" Grid.Column="1" Foreground="#FFD85A" Text="1.00" />
                        </Grid>
                        <Slider x:Name="GammaSlider" Minimum="0.4" Maximum="2.2" Value="1" TickFrequency="0.05" ValueChanged="SettingsControl_Changed" />

                        <CheckBox x:Name="EdgeEnhancementCheckBox" Margin="0,14,0,0" Content="Highlight strong visual edges"
                                  Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                        <CheckBox x:Name="MotionEmphasisCheckBox" Margin="0,9,0,0" Content="Emphasize general visible motion"
                                  Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />

                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Motion sensitivity" /><TextBlock x:Name="MotionThresholdValue" Grid.Column="1" Foreground="#FFD85A" Text="28" />
                        </Grid>
                        <Slider x:Name="MotionThresholdSlider" Minimum="8" Maximum="90" Value="28" IsDirectionReversed="True" ValueChanged="SettingsControl_Changed" />

                        <CheckBox x:Name="AdaptiveTuningCheckBox" Margin="0,12,0,0" Content="Adapt filters to visible scene conditions"
                                  Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                        <CheckBox x:Name="RollingReplayCheckBox" Margin="0,9,0,0" IsChecked="True" Content="Keep local rolling replay in memory"
                                  Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />

                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Replay memory" /><TextBlock x:Name="ReplaySecondsValue" Grid.Column="1" Foreground="#FFD85A" Text="20s" />
                        </Grid>
                        <Slider x:Name="ReplaySecondsSlider" Minimum="5" Maximum="120" Value="20" TickFrequency="5" ValueChanged="SettingsControl_Changed" />

                        <CheckBox x:Name="CrosshairCheckBox" Margin="0,10,0,0" IsChecked="True" Content="High-visibility center guide"
                                  Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />

                        <Separator Margin="0,16,0,14" Background="#313846" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Directional Audio Grid" />
                        <CheckBox x:Name="DirectionalAudioCheckBox" Margin="0,10,0,0" Content="Enable motion-region audio cues"
                                  Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />

                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Cue volume" /><TextBlock x:Name="CueVolumeValue" Grid.Column="1" Foreground="#FFD85A" Text="18%" />
                        </Grid>
                        <Slider x:Name="CueVolumeSlider" Minimum="2" Maximum="65" Value="18" ValueChanged="SettingsControl_Changed" />

                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Minimum cue interval" /><TextBlock x:Name="CueCooldownValue" Grid.Column="1" Foreground="#FFD85A" Text="550 ms" />
                        </Grid>
                        <Slider x:Name="CueCooldownSlider" Minimum="100" Maximum="2000" Value="550" TickFrequency="50" ValueChanged="SettingsControl_Changed" />

                        <TextBlock Margin="0,10,0,5" FontSize="12" Foreground="#98A1B1"
                                   Text="Edit pitch in hertz. Press a cell to preview its stereo position and pitch." />

                        <Grid>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0"><TextBox x:Name="Cue0TextBox" Text="920" TextChanged="CueFrequency_Changed" /><Button Tag="0" Content="↖" Click="PreviewCueButton_Click" /></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1"><TextBox x:Name="Cue1TextBox" Text="1000" TextChanged="CueFrequency_Changed" /><Button Tag="1" Content="↑" Click="PreviewCueButton_Click" /></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2"><TextBox x:Name="Cue2TextBox" Text="1080" TextChanged="CueFrequency_Changed" /><Button Tag="2" Content="↗" Click="PreviewCueButton_Click" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0"><TextBox x:Name="Cue3TextBox" Text="560" TextChanged="CueFrequency_Changed" /><Button Tag="3" Content="←" Click="PreviewCueButton_Click" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1"><TextBox x:Name="Cue4TextBox" Text="640" TextChanged="CueFrequency_Changed" /><Button Tag="4" Content="●" Click="PreviewCueButton_Click" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2"><TextBox x:Name="Cue5TextBox" Text="720" TextChanged="CueFrequency_Changed" /><Button Tag="5" Content="→" Click="PreviewCueButton_Click" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0"><TextBox x:Name="Cue6TextBox" Text="280" TextChanged="CueFrequency_Changed" /><Button Tag="6" Content="↙" Click="PreviewCueButton_Click" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1"><TextBox x:Name="Cue7TextBox" Text="340" TextChanged="CueFrequency_Changed" /><Button Tag="7" Content="↓" Click="PreviewCueButton_Click" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2"><TextBox x:Name="Cue8TextBox" Text="400" TextChanged="CueFrequency_Changed" /><Button Tag="8" Content="↘" Click="PreviewCueButton_Click" /></StackPanel>
                        </Grid>

                        <Separator Margin="0,16,0,14" Background="#313846" />
                        <Button x:Name="StartButton" Height="48" Content="Start Live Feed" Click="StartButton_Click" />
                        <Button x:Name="PlaybackButton" Margin="0,9,0,0" Height="42" Content="Play Rolling Replay" Click="PlaybackButton_Click" />
                        <Button Margin="0,9,0,0" Height="42" Content="Clear Replay Memory" Click="ClearReplayButton_Click" />
                        <Button x:Name="ResetButton" Margin="0,9,0,0" Height="42" Content="Reset Visual Settings" Click="ResetButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="14,11" CornerRadius="10" Background="#171B23">
            <TextBlock x:Name="StatusText" Foreground="#BBC2D0" Text="Status: Ready. Standalone processing only." />
        </Border>
    </Grid>
</Window>
