<Window x:Class="SightForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SightForge — Low-Vision Gaming Toolkit"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="640"
        Background="#101218"
        Foreground="White"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="32" FontWeight="Bold" Text="SightForge" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="15"
                           Foreground="#BBC2D0"
                           Text="Universal low-vision gaming accessibility toolkit" />
            </StackPanel>
            <Border Grid.Column="1"
                    VerticalAlignment="Center"
                    Padding="12,7"
                    CornerRadius="16"
                    Background="#243127">
                <TextBlock Foreground="#A7F3B1"
                           FontWeight="SemiBold"
                           Text="Compatibility Mode" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.25*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="14" Background="#191D26" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="Live Preview" />
                        <TextBlock x:Name="PerformanceText"
                                   Grid.Column="1"
                                   Foreground="#BBC2D0"
                                   Text="0 FPS" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,14,0,14"
                            Background="Black"
                            BorderBrush="#313846"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="LowQuality" />

                            <TextBlock x:Name="PreviewPlaceholder"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="30"
                                       FontSize="17"
                                       Foreground="#98A1B1"
                                       TextAlignment="Center"
                                       Text="Press Start to capture the primary display in a separate compatibility preview." />

                            <Grid x:Name="CenterGuide"
                                  Width="76"
                                  Height="76"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                                <Ellipse Stroke="#FFFF4D" StrokeThickness="3" />
                                <Line X1="38" X2="38" Y1="0" Y2="24" Stroke="#FFFF4D" StrokeThickness="3" />
                                <Line X1="38" X2="38" Y1="52" Y2="76" Stroke="#FFFF4D" StrokeThickness="3" />
                                <Line X1="0" X2="24" Y1="38" Y2="38" Stroke="#FFFF4D" StrokeThickness="3" />
                                <Line X1="52" X2="76" Y1="38" Y2="38" Stroke="#FFFF4D" StrokeThickness="3" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Foreground="#98A1B1"
                               FontSize="13"
                               Text="SightForge captures visible pixels only. It does not read game memory, classify enemies, control input, or bypass anti-cheat software." />
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="14" Background="#191D26" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="Visibility Controls" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Center magnification" />
                            <TextBlock x:Name="MagnificationValue" Grid.Column="1" Foreground="#FFD85A" Text="1.00×" />
                        </Grid>
                        <Slider x:Name="MagnificationSlider"
                                Minimum="1"
                                Maximum="4"
                                Value="1"
                                TickFrequency="0.1"
                                ValueChanged="SettingsControl_Changed" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Contrast" />
                            <TextBlock x:Name="ContrastValue" Grid.Column="1" Foreground="#FFD85A" Text="1.00" />
                        </Grid>
                        <Slider x:Name="ContrastSlider"
                                Minimum="0.5"
                                Maximum="2.5"
                                Value="1"
                                TickFrequency="0.05"
                                ValueChanged="SettingsControl_Changed" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gamma / shadow lift" />
                            <TextBlock x:Name="GammaValue" Grid.Column="1" Foreground="#FFD85A" Text="1.00" />
                        </Grid>
                        <Slider x:Name="GammaSlider"
                                Minimum="0.4"
                                Maximum="2.2"
                                Value="1"
                                TickFrequency="0.05"
                                ValueChanged="SettingsControl_Changed" />

                        <CheckBox x:Name="EdgeEnhancementCheckBox"
                                  Margin="0,20,0,0"
                                  Content="Highlight strong visual edges"
                                  Checked="SettingsControl_Changed"
                                  Unchecked="SettingsControl_Changed" />

                        <CheckBox x:Name="MotionEmphasisCheckBox"
                                  Margin="0,12,0,0"
                                  Content="Emphasize general visible motion"
                                  Checked="SettingsControl_Changed"
                                  Unchecked="SettingsControl_Changed" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Motion sensitivity" />
                            <TextBlock x:Name="MotionThresholdValue" Grid.Column="1" Foreground="#FFD85A" Text="28" />
                        </Grid>
                        <Slider x:Name="MotionThresholdSlider"
                                Minimum="8"
                                Maximum="90"
                                Value="28"
                                TickFrequency="1"
                                IsDirectionReversed="True"
                                ValueChanged="SettingsControl_Changed" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="#98A1B1"
                                   Text="Higher sensitivity can also highlight camera motion, particles, foliage, and interface animation." />

                        <CheckBox x:Name="CrosshairCheckBox"
                                  Margin="0,14,0,0"
                                  IsChecked="True"
                                  Content="High-visibility center guide"
                                  Checked="SettingsControl_Changed"
                                  Unchecked="SettingsControl_Changed" />

                        <Separator Margin="0,20,0,18" Background="#313846" />

                        <Button x:Name="StartButton"
                                Height="48"
                                Content="Start Compatibility Preview"
                                Click="StartButton_Click" />

                        <Button x:Name="ResetButton"
                                Margin="0,10,0,0"
                                Height="42"
                                Content="Reset Visual Settings"
                                Click="ResetButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="14,11" CornerRadius="10" Background="#171B23">
            <TextBlock x:Name="StatusText"
                       Foreground="#BBC2D0"
                       Text="Status: Ready. No game-memory access or input automation." />
        </Border>
    </Grid>
</Window>
