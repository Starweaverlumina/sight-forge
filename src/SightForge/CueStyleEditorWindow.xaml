<Window x:Class="SightForge.CueStyleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SightForge Cue Appearance Editor"
        Width="760"
        Height="680"
        MinWidth="620"
        MinHeight="520"
        Background="#101218"
        Foreground="White"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26" FontWeight="Bold" Text="Cue Appearance Editor" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#BBC2D0"
                       Text="Choose colors and non-color identifiers for each sound or motion event. SightForge never relies on color alone." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ThemeComboBox" Height="38" SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="Standard" />
                <ComboBoxItem Content="High Contrast Color-Blind Safe" />
                <ComboBoxItem Content="Custom" />
            </ComboBox>
            <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,7" Content="Restore Stock" Click="RestoreStock_Click" />
            <Button Grid.Column="2" Margin="10,0,0,0" Padding="14,7" Content="High Contrast Preset" Click="HighContrast_Click" />
        </Grid>

        <Border Grid.Row="2" Background="#191D26" CornerRadius="12" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CueItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="12" CornerRadius="10" BorderBrush="#313846" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="135" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="6" Background="{Binding PreviewBrush}" BorderBrush="White" BorderThickness="1" />
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Style.DisplayName}" />
                                        <TextBlock FontSize="12" Foreground="#98A1B1" Text="{Binding Style.EventId}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="2" Height="34" Text="{Binding Style.ColorHex, UpdateSourceTrigger=PropertyChanged}" TextChanged="ColorTextBox_TextChanged" />
                                    <ComboBox Grid.Column="3" Margin="8,0,0,0" Height="34" SelectedValue="{Binding Style.Shape}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="SolidWedge" />
                                        <ComboBoxItem Content="DashedWedge" />
                                        <ComboBoxItem Content="FilledArc" />
                                        <ComboBoxItem Content="DoubleOutline" />
                                        <ComboBoxItem Content="Diamond" />
                                        <ComboBoxItem Content="OutlineWedge" />
                                    </ComboBox>
                                    <ComboBox Grid.Column="4" Margin="8,0,0,0" Height="34" SelectedValue="{Binding Style.PulsePattern}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="Steady" />
                                        <ComboBoxItem Content="FastPulse" />
                                        <ComboBoxItem Content="RhythmicPulse" />
                                        <ComboBoxItem Content="ExpandingRing" />
                                        <ComboBoxItem Content="SlowSweep" />
                                        <ComboBoxItem Content="Flash" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" VerticalAlignment="Center" Foreground="#BBC2D0" Text="Colors use #RRGGBB or #AARRGGBB." />
            <Button Grid.Column="1" Margin="8,0" Padding="18,8" Content="Cancel" Click="Cancel_Click" />
            <Button Grid.Column="2" Padding="18,8" Content="Save Changes" Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
