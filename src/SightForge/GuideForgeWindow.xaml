<Window x:Class="SightForge.GuideForgeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SightForge GuideForge" Width="980" Height="720" Background="#10141C" Foreground="White">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock FontSize="30" FontWeight="Bold" Text="GuideForge"/><TextBlock Margin="0,8,0,14" FontSize="16" Foreground="#C2CBD8" Text="Research the selected game and provide accessible, spoiler-aware help from approved web sources."/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Game title"/><TextBox x:Name="GameText" FontSize="17" Padding="8"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Platform"/><TextBox x:Name="PlatformText" FontSize="17" Padding="8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="OpenAI API key for this session"/><PasswordBox x:Name="ApiKeyBox" FontSize="17" Padding="8" AutomationProperties.Name="OpenAI API key, not saved"/></StackPanel></Grid>
<Grid Grid.Row="2" Margin="0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBox x:Name="QuestionText" FontSize="19" Padding="12" Text="What accessibility settings and beginner guidance should I use?" AutomationProperties.Name="Game help question"/>
<TextBox x:Name="AnswerText" Grid.Row="1" Margin="0,12" FontSize="21" Padding="16" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#05070A" Foreground="White" AutomationProperties.Name="GuideForge answer"/>
<StackPanel Grid.Row="2" Orientation="Horizontal"><CheckBox x:Name="SpoilerCheck" FontSize="16" Content="Allow spoilers"/><Button Margin="18,0,0,0" Padding="16,10" Click="ResearchButton_Click" Content="Research and Answer"/><Button Margin="10,0,0,0" Padding="16,10" Click="SpeakButton_Click" Content="Read Answer Aloud"/></StackPanel></Grid>
<TextBlock x:Name="StatusText" Grid.Row="3" FontSize="15" Foreground="#C2CBD8" Text="API key is used only for the current request and is not written to a profile."/>
</Grid></Window>