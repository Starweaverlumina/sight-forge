<Window x:Class="SightForge.ProfileManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SightForge Profiles" Width="920" Height="620" Background="#10141C" Foreground="White">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock FontSize="30" FontWeight="Bold" Text="Accessibility Profiles"/><TextBlock Margin="0,8,0,14" FontSize="16" Foreground="#C2CBD8" Text="Create and manage portable game-specific accessibility settings."/><StackPanel Orientation="Horizontal"><Button Padding="14,9" Click="NewButton_Click" Content="New Profile"/><Button Margin="10,0,0,0" Padding="14,9" Click="SaveButton_Click" Content="Save"/><Button Margin="10,0,0,0" Padding="14,9" Click="RefreshButton_Click" Content="Refresh"/></StackPanel></StackPanel>
<Grid Grid.Row="1" Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
<ListBox x:Name="ProfilesList" FontSize="18" SelectionChanged="ProfilesList_SelectionChanged" DisplayMemberPath="DisplayName" AutomationProperties.Name="Saved accessibility profiles"/>
<StackPanel Grid.Column="2"><TextBlock Text="Profile name"/><TextBox x:Name="NameText" Margin="0,4,0,12" FontSize="18"/><TextBlock Text="Game title"/><TextBox x:Name="GameText" Margin="0,4,0,12" FontSize="18"/><TextBlock Text="Platform"/><TextBox x:Name="PlatformText" Margin="0,4,0,12" FontSize="18"/><CheckBox x:Name="HighContrastCheck" Margin="0,8" FontSize="17" Content="Use high-contrast color-blind-safe cue theme"/><CheckBox x:Name="SpeakClockCheck" Margin="0,8" FontSize="17" Content="Speak clock directions"/><TextBlock x:Name="DetailText" Margin="0,18,0,0" Foreground="#C2CBD8"/></StackPanel>
</Grid><TextBlock x:Name="StatusText" Grid.Row="2" FontSize="15" Foreground="#C2CBD8" Text="Ready."/></Grid></Window>